# ---------------------------------------------------------------------------
# JobSeeker - configurazione. Copia questo file in ".env" e compila i valori.
# Tutto è opzionale: l'app parte comunque e queste voci si possono impostare
# anche dalla pagina Impostazioni dell'interfaccia web.
# ---------------------------------------------------------------------------

# Porta del server web locale (ignorata dentro Docker, dove e' sempre 8000)
JOBSEEKER_PORT=8000

# --- Accesso al server (OBBLIGATORIO su internet) ---------------------------
# Utente e password per entrare. Si possono lasciare vuoti: al primo avvio
# l'applicazione apre una pagina di configurazione dove sceglierli, e da lì si
# incollano anche le chiavi qui sotto senza toccare questo file.
# Scegline una lunga e non riusata: protegge il curriculum, lo storico delle
# candidature e le chiavi API qui sotto.
# Per generarne una: openssl rand -base64 24
JOBSEEKER_USER=
JOBSEEKER_PASSWORD=

# --- Dominio per HTTPS ------------------------------------------------------
# Il nome a cui risponde il server, per esempio jobseeker.miodominio.it
# Deve gia' puntare all'IP di questa macchina prima del primo avvio: Caddy
# chiede il certificato a Let's Encrypt e la verifica passa da li'.
DOMINIO=

# --- Adzuna (fonte generalista per l'Italia) -------------------------------
# Chiavi gratuite su https://developer.adzuna.com/  ->  "Sign up"
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Notifiche Telegram (consigliate per il telefono) ----------------------
# 1. Su Telegram cerca @BotFather, invia /newbot e segui le istruzioni:
#    ti restituisce un token del tipo 123456789:AA...
# 2. Apri il bot appena creato e scrivigli qualcosa (anche solo "ciao").
# 3. Il numero della chat lo trova l'app: Impostazioni -> "Trova la chat".
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifiche email -------------------------------------------------------
# Esempio Gmail: smtp.gmail.com / 587 / la tua mail / una "app password"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFY_EMAIL_TO=

# --- Motore semantico opzionale --------------------------------------------
# Lasciare vuoto per usare solo il matching lessicale offline (default).
# Basta UNO dei tre; il fornitore si sceglie dalla pagina Impostazioni.

# Gemini: chiave gratuita su https://aistudio.google.com/apikey
#   con un normale account Google, senza carta di credito.
#   Libreria:  pip install google-genai
GEMINI_API_KEY=

# Claude: richiede un'organizzazione Console con fatturazione su
#   https://platform.claude.com  (servizio separato dall'abbonamento Claude).
#   Libreria:  pip install anthropic
ANTHROPIC_API_KEY=

# Modello locale, o qualunque servizio con API compatibile OpenAI.
#   Nessuna libreria da installare. Con un modello sul proprio computer non
#   serve nessuna chiave, non costa niente e il curriculum non esce dalla
#   macchina. L'indirizzo deve finire con /v1:
#     Ollama      http://localhost:11434/v1
#     LM Studio   http://localhost:1234/v1
#     OpenAI      https://api.openai.com/v1     (qui la chiave serve)
#
#   ATTENZIONE con Docker: dentro il contenitore "localhost" e' il contenitore
#   stesso, non il tuo computer. Per raggiungere un Ollama che gira sull'host
#   serve  http://host.docker.internal:11434/v1  e, su Linux, la riga
#   extra_hosts: ["host.docker.internal:host-gateway"]  nel docker-compose.yml.
OPENAI_BASE_URL=
OPENAI_API_KEY=
